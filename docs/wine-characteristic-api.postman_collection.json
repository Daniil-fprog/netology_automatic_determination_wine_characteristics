            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descriptions\": [\n    \"Красное вино с ароматом вишни и пряностей, плотным вкусом и мягкими танинами.\",\n    \"Белое сухое вино с цитрусовым ароматом, свежей кислотностью и лёгким минеральным послевкусием.\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
